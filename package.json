{
  "name": "@lightproject/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A Vite+-powered monorepo starter with a Hono/Fetch-API backend, a React frontend, and a shared design system.",
  "homepage": "https://github.com/wataruian/viteplus#readme",
  "bugs": {
    "url": "https://github.com/wataruian/viteplus/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wataruian/viteplus.git"
  },
  "type": "module",
  "scripts": {
    "clean:ai": "rimraf -g \".ai-data/artifacts/**/*\" \".ai-data/artifacts/!(*.gitkeep)\"",
    "clean:build": "vp cache clean && rimraf -g .vite-hooks/_ **/__unconfig_vite.config.ts dagger/sdk packages/**/tmp/** apps/**/tmp/** templates/**/tmp/** **/dist/** **/out/** **/storybook-static/** **/coverage/** **/e2e-test-results/** **/.wrangler/** **/.pruned/** **/tsconfig.tsbuildinfo vite.config.d.ts vite.config.d.ts.map",
    "clean:modules": "rimraf -g --max-retries=10 --retry-delay=100 **/node_modules/**",
    "clean:tools": "rimraf -g **/tmp/**",
    "debug": "vp cache clean && vpr ready",
    "init": "vp install --frozen-lockfile && vpr ready",
    "prepare": "vp config",
    "prune": "vp exec turbo prune --out-dir ./.pruned --docker",
    "ready": "vpr -r madge && vpr -r root:check && vpr -r root:test:unit && vpr -r dagger:check && vpr -r dagger:format && vpr -r dagger:lint && vpr -r dagger:type-check && vpr -r dagger:test:unit && vpr -r check && vpr -r format && vpr -r lint && vpr -r type-check && vpr -r build && vpr -r test:unit && vpr -r test:integration && vpr -r test:e2e",
    "serve:dev": "vpr -r --parallel dev",
    "serve:prod": "vpr -r --parallel start",
    "serve:wrangler": "vpr -r --parallel wrangler:dev",
    "setup": "./install.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:",
    "commitizen": "catalog:",
    "cz-conventional-changelog": "catalog:",
    "madge": "catalog:",
    "markdown-it": "catalog:",
    "plop": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vscode-json-languageservice": "catalog:",
    "vscode-languageserver-textdocument": "catalog:",
    "vscode-markdown-languageservice": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.15.0"
  }
}
