{
  "name": "@lightproject/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A Vite+-powered monorepo starter with a Hono/Fetch-API backend, a React frontend, and a shared design system.",
  "homepage": "https://github.com/wataruian/viteplus#readme",
  "bugs": {
    "url": "https://github.com/wataruian/viteplus/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wataruian/viteplus.git"
  },
  "type": "module",
  "scripts": {
    "clean:ai": "rimraf -g \".ai-data/artifacts/**/*\" \".ai-data/artifacts/!(*.gitkeep)\"",
    "clean:build": "vp cache clean && rimraf -g .vite-hooks/_ **/__unconfig_vite.config.ts .dagger/sdk packages/**/tmp/** apps/**/tmp/** **/dist/** **/out/** **/storybook-static/** **/coverage/** **/.wrangler/** **/.pruned/** **/tsconfig.tsbuildinfo vite.config.d.ts vite.config.d.ts.map",
    "clean:modules": "rimraf -g --max-retries=10 --retry-delay=100 **/node_modules/**",
    "clean:tools": "rimraf -g **/tmp/**",
    "debug": "vp cache clean && vp run ready",
    "init": "vp install && vp run ready",
    "prepare": "vp config",
    "prune": "vp exec turbo prune --out-dir ./.pruned --docker",
    "ready": "vp run -r madge && vp run -r root && vp run -r check && vp run -r format && vp run -r lint && vp run -r type-check && vp run -r build && vp run -r test",
    "serve:dev": "vp run -r --parallel dev",
    "serve:prod": "vp run -r --parallel start",
    "setup": "./install.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:",
    "commitizen": "catalog:",
    "cz-conventional-changelog": "catalog:",
    "madge": "catalog:",
    "plop": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.14.1"
  }
}
