{
  "name": "@lightproject/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:ai": "rimraf -g .ai-data",
    "clean:tools": "rimraf -g **/tmp/**",
    "clean:build": "vp cache clean && rimraf -g .vite-hooks/_ **/__unconfig_vite.config.ts **/node_modules/** **/dist/** **/coverage/** **/tsconfig.tsbuildinfo vite.config.d.ts vite.config.d.ts.map",
    "root": "vp check",
    "ready": "vp run -r check && vp run -r format && vp run -r lint && vp run -r type-check && vp run -r build && vp run -r test",
    "setup": "./install.sh",
    "init": "vp install && vp run ready",
    "debug": "vp cache clean && vp run ready",
    "madge": "madge --circular --warning --ts-config ./tsconfig.madge.json --extensions ts,tsx packages apps",
    "prepare": "vp config",
    "serve:dev": "vp run -r --parallel dev",
    "serve:prod": "vp run -r --parallel start"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:",
    "madge": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.14.1"
  }
}
