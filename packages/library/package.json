{
  "name": "@lightproject/library",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": {
    "node:async_hooks": false,
    "node:crypto": false,
    "node:fs": false,
    "node:path": false,
    "node:url": false,
    "node:util": false
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": [
      {
        "typescript": "./src/index.ts"
      },
      {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.cts"
        }
      },
      {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    ],
    "./*": [
      {
        "typescript": "./src/*/index.ts"
      },
      {
        "types": {
          "import": "./dist/*/index.d.mts",
          "require": "./dist/*/index.d.cts"
        }
      },
      {
        "import": "./dist/*/index.mjs",
        "require": "./dist/*/index.cjs"
      }
    ],
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
