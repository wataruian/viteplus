{
  "name": "@lightproject/common",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "typescript": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./*": {
      "typescript": {
        "types": "./src/*/index.ts",
        "default": "./src/*/index.ts"
      },
      "require": {
        "types": "./dist/*/index.d.cts",
        "default": "./dist/*/index.cjs"
      },
      "import": {
        "types": "./dist/*/index.d.mts",
        "default": "./dist/*/index.mjs"
      }
    },
    "./*/**": {
      "typescript": {
        "types": "./src/*/index.ts",
        "default": "./src/*/index.ts"
      },
      "require": {
        "types": "./dist/*/**/*.d.cts",
        "default": "./dist/*/**/*.cjs"
      },
      "import": {
        "types": "./dist/*/**/*.d.mts",
        "default": "./dist/*/**/*.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vp test",
    "build:dev": "tsc && ENV=local vp pack",
    "build:ci": "tsc && vp pack",
    "watch": "ENV=local vp pack --watch",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "lodash.isplainobject": "catalog:",
    "picocolors": "catalog:",
    "redact-object": "catalog:",
    "rotating-file-stream": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
