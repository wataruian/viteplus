{
  "name": "@lightproject/common",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": {
    "node:async_hooks": false,
    "node:crypto": false,
    "node:fs": false,
    "node:path": false,
    "node:url": false,
    "node:util": false
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": [
      {
        "typescript": "./src/index.ts"
      },
      {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.cts"
        }
      },
      {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    ],
    "./*": [
      {
        "typescript": "./src/*/index.ts"
      },
      {
        "types": {
          "import": "./dist/*/index.d.mts",
          "require": "./dist/*/index.d.cts"
        }
      },
      {
        "import": "./dist/*/index.mjs",
        "require": "./dist/*/index.cjs"
      }
    ],
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@grafana/faro-react": "catalog:",
    "@grafana/faro-web-sdk": "catalog:",
    "@grafana/faro-web-tracing": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-prometheus": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-fetch": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "chalk": "catalog:",
    "picocolors": "catalog:",
    "redact-object": "catalog:",
    "rotating-file-stream": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
