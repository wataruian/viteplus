{
  "name": "@lightproject/design-system",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": {
    "node:async_hooks": false,
    "node:crypto": false,
    "node:fs": false,
    "node:path": false,
    "node:url": false,
    "node:util": false
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "typescript": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./*": {
      "typescript": {
        "types": "./src/*/index.ts",
        "default": "./src/*/index.ts"
      },
      "require": {
        "types": "./dist/*/index.d.cts",
        "default": "./dist/*/index.cjs"
      },
      "import": {
        "types": "./dist/*/index.d.mts",
        "default": "./dist/*/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@iconify-json/logos": "catalog:",
    "@iconify-json/ph": "catalog:",
    "@unocss/preset-wind3": "catalog:",
    "@unocss/transformer-directives": "catalog:",
    "@unocss/transformer-variant-group": "catalog:",
    "class-variance-authority": "catalog:",
    "culori": "catalog:",
    "fast-glob": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "unocss": "catalog:"
  },
  "devDependencies": {
    "@types/culori": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
