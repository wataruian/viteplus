{
  "name": "@lightproject/design-system",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist",
    "out",
    "storybook-static"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": [
      {
        "typescript": "./src/index.ts"
      },
      {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.cts"
        }
      },
      {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    ],
    "./*": [
      {
        "typescript": "./src/*/index.ts"
      },
      {
        "types": {
          "import": "./dist/*/index.d.mts",
          "require": "./dist/*/index.d.cts"
        }
      },
      {
        "import": "./dist/*/index.mjs",
        "require": "./dist/*/index.cjs"
      }
    ],
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@iconify-json/logos": "catalog:",
    "@iconify-json/ph": "catalog:",
    "@unocss/preset-wind3": "catalog:",
    "@unocss/transformer-directives": "catalog:",
    "@unocss/transformer-variant-group": "catalog:",
    "class-variance-authority": "catalog:",
    "culori": "catalog:",
    "fast-glob": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "unocss": "catalog:"
  },
  "devDependencies": {
    "@iconify/types": "catalog:",
    "@storybook/addon-essentials": "catalog:",
    "@storybook/blocks": "catalog:",
    "@storybook/preview-api": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/test": "catalog:",
    "@storybook/theming": "catalog:",
    "@types/culori": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
