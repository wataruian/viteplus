#!/usr/bin/env bash
#MISE description="Clean up build artifacts, tools, and AI caches"

set -o errexit # Bail out on any error

modules="false"
tools="false"
ai="false"
install="true"

for arg in "${@}"; do
  case "${arg}" in
    --modules)
      modules="true"
      ;;
    --tools)
      tools="true"
      ;;
    --ai)
      ai="true"
      ;;
    --no-install)
      install="false"
      ;;
    *)
      echo "Usage: mise run clean [--modules] [--tools] [--ai] [--no-install]"
      exit 1
      ;;
  esac
done

if [[ "${tools}" == "true" ]]; then
  vp run --no-cache clean:tools
fi

if [[ "${ai}" == "true" ]]; then
  vp run --no-cache clean:ai
fi

dagger core engine local-cache prune || true

vp run --no-cache clean:build

if [[ "${modules}" == "true" ]]; then
  vp run --no-cache clean:modules
fi

if [[ "${install}" == "true" ]]; then
  vp install --frozen-lockfile
  dagger develop
fi

echo ""
echo "✅ All good!"
