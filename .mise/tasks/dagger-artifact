#!/usr/bin/env bash
#MISE description="Run a Dagger workspace function and export its result, defaulting to ./tmp/artifacts/<name>"

set -o errexit # Bail out on any error

executingDir=$(pwd)
currentDir=$(cd -P -- "$(dirname -- "${0}")" && pwd -P)
scriptDir=$(cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)

rootDir="${scriptDir}/../.."
cd "${rootDir}"

func="${1:?"Usage: mise run dagger-artifact <function> [workspace] [path]"}"

case "${func}" in
  root|madge|ready)
    path="${2:-"./tmp/artifacts"}"
    dagger call "${func}" export --path="${path}" && cat "${path}/${func}.output"
    ;;
  build)
    workspace="${2:?"Usage: mise run dagger-artifact build <workspace> [path]"}"
    path="${3:-"./tmp/artifacts/${workspace##*/}"}"
    buildArgs=()
    case "${workspace}" in
      "@lightproject/frontend")
        buildArgs+=(
          --build-env="VITE_API_URL=${VITE_API_URL}"
        )
        ;;
      *)
        ;;
    esac
    buildArgs+=(
      --workspace="${workspace}"
    )
    dagger call build-artifact "${buildArgs[@]}" export --path="${path}/build"
    ;;
  test)
    workspace="${2:?"Usage: mise run dagger-artifact test <workspace> [path]"}"
    path="${3:-"./tmp/artifacts/${workspace##*/}"}"
    dagger call test --workspace="${workspace}" export --path="${path}"
    cat "${path}/test.output"
    exit "$(cat "${path}/test.exit-code")"
    ;;
  semgrep)
    workspace="${2:?"Usage: mise run dagger-artifact semgrep <workspace> [path]"}"
    path="${3:-"./tmp/artifacts/${workspace##*/}"}"
    dagger call semgrep --workspace="${workspace}" export --path="${path}"
    cat "${path}/semgrep.output"
    exit "$(cat "${path}/semgrep.exit-code")"
    ;;
  sonar)
    workspace="${2:?"Usage: mise run dagger-artifact sonar <workspace> [path] [sonar_host_url]"}"
    path="${3:-"./tmp/artifacts/${workspace##*/}"}"
    sonarHostUrl="${4:-"${SONAR_HOST_URL}"}"
    sonarArgs=(
      --workspace="${workspace}"
      --sonar-token=env:SONAR_TOKEN
    )
    if [[ -n "${sonarHostUrl:-}" ]]; then
      sonarArgs+=(--sonar-host-url="${sonarHostUrl}")
    else
      dockerSocket="${DOCKER_SOCKET:-"/var/run/docker.sock"}"
      sonarArgs+=(--docker-socket="${dockerSocket}")
    fi
    dagger call sonar "${sonarArgs[@]}" export --path="${path}"
    cat "${path}/sonar.output"
    exit "$(cat "${path}/sonar.exit-code")"
    ;;
  *)
    workspace="${2:?"Usage: mise run dagger-artifact <function> <workspace> [path]"}"
    path="${3:-"./tmp/artifacts/${workspace##*/}"}"
    dagger call "${func}" --workspace="${workspace}" export --path="${path}" && cat "${path}/${func}.output"
    ;;
esac
