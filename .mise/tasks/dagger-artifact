#!/usr/bin/env bash
#MISE description="Run a Dagger workspace function and export its result, defaulting to ./tmp/artifacts/<name>"

set -o errexit # Bail out on any error

executingDir=$(pwd)
currentDir=$(cd -P -- "$(dirname -- "${0}")" && pwd -P)
scriptDir=$(cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)

rootDir="${scriptDir}/../.."
cd "${rootDir}"

func="${1:?"Usage: mise run dagger-artifact <function> [workspace] [path]"}"

command="${func}"
checkOutput="true"
checkExitCode="true"

args=()
if [[ "${func}" == "root" || \
  "${func}" == "madge" || \
  "${func}" == "ready" ]]; then
  path="${2:-"./tmp/artifacts"}"
else
  workspace="${2:?"Usage: mise run dagger-artifact <function> <workspace> [path]"}"
  path="${3:-"./tmp/artifacts/${workspace##*/}"}"
  checkExitCode="false"
  args+=(--workspace="${workspace}")
fi

outputFile="${path}/${func}.output"
exitCodeFile="${path}/${func}.exit-code"
exportPath="${path}"

case "${func}" in
  build)
    command="build-artifact"
    exportPath="${path}/build"
    checkOutput="false"
    checkExitCode="false"
    case "${workspace}" in
      "@lightproject/design-system"|"@lightproject/frontend")
        args+=(--build-env="VITE_ENV=${VITE_ENV}")
        args+=(--build-env="VITE_API_URL=${VITE_API_URL}")
      ;;
    esac
    ;;
  sonar)
    args+=(--sonar-token=env:SONAR_TOKEN)
    if [[ -n "${SONAR_HOST_URL}" ]]; then
      args+=(--sonar-host-url="${SONAR_HOST_URL}")
    else
      args+=(--docker-socket="${DOCKER_SOCKET:-"/var/run/docker.sock"}")
    fi
    ;;
  *)
    checkExitCode="false"
    ;;
esac

args=(dagger call "${command}" "${args[@]}")
args+=(export --path="${exportPath}")

"${args[@]}"

if [[ "${checkOutput}" == "true" ]]; then
  cat "${outputFile}"
fi

if [[ "${checkExitCode}" == "true" ]]; then
  exit "$(cat "${exitCodeFile}")"
fi
