#!/usr/bin/env bash
#MISE description="Run the Gitleaks secret scan against the repo"

set -o errexit # Bail out on any error

executingDir=$(pwd)
currentDir=$(cd -P -- "$(dirname -- "${0}")" && pwd -P)
scriptDir=$(cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)

rootDir="${scriptDir}/../.."
cd "${rootDir}"

gitleaks_image="ghcr.io/gitleaks/gitleaks:v8.30.1"

echo "Running Gitleaks secret scan..."
container_id="$(docker create "${gitleaks_image}" detect --source=/repo --redact --verbose)"
docker cp . "${container_id}:/repo"
docker start "${container_id}" >/dev/null
docker logs -f "${container_id}"
exit_code="$(docker wait "${container_id}")"
docker rm "${container_id}" >/dev/null

if [[ "${exit_code}" == "0" ]]; then
  echo "✅ Gitleaks scan done — no leaks found"
else
  echo "❌ Gitleaks scan done — leaks found or an error occurred, exit code ${exit_code}"
fi

exit "${exit_code}"
