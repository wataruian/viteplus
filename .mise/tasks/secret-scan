#!/usr/bin/env bash
#MISE description="Run the Gitleaks secret scan against the repo"

set -o errexit # Bail out on any error

gitLeaksImage="ghcr.io/gitleaks/gitleaks:v8.30.1"

echo "Running Gitleaks secret scan..."
containerId="$(docker create "${gitLeaksImage}" detect --source=/repo --config=/repo/.gitleaks.toml --redact --verbose)"
docker cp . "${containerId}:/repo"
docker start "${containerId}" >/dev/null
docker logs -f "${containerId}"
exitCode="$(docker wait "${containerId}")"
docker rm "${containerId}" >/dev/null

if [[ "${exitCode}" == "0" ]]; then
  echo "✅ Gitleaks scan done — no leaks found"
else
  echo "❌ Gitleaks scan done — leaks found or an error occurred, exit code ${exitCode}"
fi

exit "${exitCode}"
