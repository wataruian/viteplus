#!/usr/bin/env bash
#MISE description="Create standard backend, frontend, and library templates"

set -o errexit # Bail out on any error

type="backend"
name="sample"

while [[ "${#}" -gt 0 ]]; do
  case "$1" in
    --type=*)
      type="${1#--type=}"
      shift
      ;;
    --type)
      type="${2}"
      shift 2
      ;;
    --name=*)
      name="${1#--name=}"
      shift
      ;;
    --name)
      name="${2}"
      shift 2
      ;;
    *)
      echo "Usage: mise run create [--type=backend|frontend|library] [--name=<name>]"
      exit 1
      ;;
  esac
done

if [[ "${type}" != "backend" && "${type}" != "frontend" && "${type}" != "library" ]]; then
  echo "Invalid type: ${type}"
  exit 1
fi

echo "Type: ${type}, Name: ${name}"

vp create "${type}" -- "${name}"

echo ""
echo "✅ All good!"
