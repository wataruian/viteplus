#!/usr/bin/env bash
#MISE description="Run the SonarQube scanner against the persistent SonarQube instance and write the quality gate/issues reports to tmp/sonar"

set -o errexit # Bail out on any error

executingDir=$(pwd)
currentDir=$(cd -P -- "$(dirname -- "${0}")" && pwd -P)
scriptDir=$(cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)

rootDir="${scriptDir}/../.."
cd "${rootDir}"

if [[ -z "${SONAR_TOKEN:-}" ]]; then
  echo "SONAR_TOKEN is not set. Generate a token in the persistent SonarQube instance (http://sonarqube:9000) and either:" >&2
  echo "  - export SONAR_TOKEN=... before running this task locally, or" >&2
  echo "  - set it as the SONAR_TOKEN repository secret in CI." >&2
  exit 1
fi

curl_image="curlimages/curl:8.14.1"
sonar_url="${SONAR_HOST_URL:-"http://sonarqube:9000"}"
docker_network="${SONAR_DOCKER_NETWORK:-"viteplus-net"}"
project_key="$(grep '^sonar.projectKey=' sonar-project.properties | cut -d= -f2-)"

outDir="${scriptDir}/../../tmp/sonar"
mkdir -p "${outDir}"

echo "Checking SonarQube readiness..."
health=""
for _ in $(seq 1 6); do
  health="$(docker inspect --format '{{.State.Health.Status}}' sonarqube 2>/dev/null || true)"
  [[ "${health}" == "healthy" ]] && break
  sleep 5
done
if [[ "${health}" != "healthy" ]]; then
  echo "SonarQube is not ready yet (status: ${health:-unknown}). Wait for it to report healthy and re-run this task." >&2
  docker logs --tail 200 sonarqube || true
  exit 1
fi

sonarscan_image="sonarsource/sonar-scanner-cli:12.1.0.3233_8.0.1"

echo "Running sonar-scanner..."
container_id="$(docker create --network "${docker_network}" --platform linux/amd64 \
  -e SONAR_HOST_URL="${sonar_url}" \
  -e SONAR_TOKEN="${SONAR_TOKEN}" \
  -w /usr/src \
  "${sonarscan_image}" \
  -Dsonar.qualitygate.wait=true)"
docker cp . "${container_id}:/usr/src"
docker start "${container_id}" >/dev/null
docker logs -f "${container_id}"
exit_code="$(docker wait "${container_id}")"
docker cp "${container_id}:/tmp/.scannerwork/report-task.txt" "${outDir}/report-task.txt" \
  || echo "::warning::Could not copy report-task.txt from the scanner container; quality gate/issues report will be unavailable" >&2
docker rm "${container_id}" >/dev/null

if [[ -f "${outDir}/report-task.txt" ]]; then
  ce_task_id="$(grep '^ceTaskId=' "${outDir}/report-task.txt" | cut -d= -f2-)"

  echo "Waiting for the background analysis task to finish..."
  task_json="{}"
  for _ in $(seq 1 30); do
    task_json="$(docker run --rm --network "${docker_network}" "${curl_image}" -s -u "${SONAR_TOKEN}:" \
      "${sonar_url}/api/ce/task?id=${ce_task_id}")"
    task_status="$(echo "${task_json}" | grep -o '"status":"[A-Z]*"' | head -1 | cut -d'"' -f4 || true)"
    [[ "${task_status}" == "SUCCESS" || "${task_status}" == "FAILED" || "${task_status}" == "CANCELED" ]] && break
    sleep 3
  done
  echo "${task_json}" > "${outDir}/ce-task.json"

  analysis_id="$(echo "${task_json}" | grep -o '"analysisId":"[^"]*"' | cut -d'"' -f4 || true)"

  if [[ -n "${analysis_id}" ]]; then
    docker run --rm --network "${docker_network}" "${curl_image}" -s -u "${SONAR_TOKEN}:" \
      "${sonar_url}/api/qualitygates/project_status?analysisId=${analysis_id}" \
      > "${outDir}/sonar-quality-gate.json" || true
  fi

  docker run --rm --network "${docker_network}" "${curl_image}" -s -u "${SONAR_TOKEN}:" \
    "${sonar_url}/api/issues/search?componentKeys=${project_key}&resolved=false&ps=50" \
    > "${outDir}/sonar-issues.json" || true
fi

if [[ "${exit_code}" == "0" ]]; then
  echo "✅ Sonar scan done — quality gate passed"
else
  echo "❌ Sonar scan done — quality gate failed or an error occurred, exit code ${exit_code}"
fi

exit "${exit_code}"
