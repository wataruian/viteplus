#!/usr/bin/env bash
#MISE description="Run or stop the local docker services (up|down)"

set -o errexit # Bail out on any error

action="${1:?"Usage: mise run docker <up|down> [--app=<name>]"}"
shift

if [[ "${action}" != "up" && "${action}" != "down" ]]; then
  echo "Invalid action: ${action} (expected up or down)"
  exit 1
fi

app=""
while [[ "${#}" -gt 0 ]]; do
  case "${1}" in
    --app=*)
      app="${1#--app=}"
      shift
      ;;
    --app)
      app="${2}"
      shift 2
      ;;
    *)
      echo "Unknown flag: ${1}"
      exit 1
      ;;
  esac
done

dockerSocket="${DOCKER_SOCKET:-"/var/run/docker.sock"}"

projects=(
  "@lightproject/design-system"
  "@lightproject/backend"
  "@lightproject/frontend"
)

if [[ -n "${app}" ]]; then
  projects=("@lightproject/${app}")
fi

for project in "${projects[@]}"; do
  name="${project##*/}"

  if [[ "${action}" == "down" ]]; then
    echo "Stopping: ${project}"
    docker rm -f "${name}" || true
    echo "✅ ${name} is stopped"
    continue
  fi

  storybookPort=""
  containerPort="80"
  storybookContainerPort="81"
  buildEnvArgs=()
  runArgs=()

  if [[ "${name}" == "design-system" || "${name}" == "frontend" ]]; then
    buildEnvArgs+=(
      "--build-env=VITE_ENV=${VITE_ENV}"
      "--build-env=VITE_BACKEND_URL=${VITE_BACKEND_URL}"
    )
  fi

  case "${name}" in
    "backend")
      port="${BACKEND_PORT:-"2000"}"
      containerPort="${port}"
      runArgs+=(-e "BACKEND_PORT=${port}")
      if docker network inspect viteplus-net >/dev/null 2>&1; then
        runArgs+=(
          --network viteplus-net
          -e "OTLP_ENDPOINT=http://otel-collector:4318"
        )
      else
        echo "⚠️  viteplus-net not found (run docker compose up -d): backend telemetry will not be exported"
      fi
      ;;
    "design-system")
      port="${DESIGN_SYSTEM_PORT:-"6007"}"
      storybookPort="${STORYBOOK_PORT:-"6006"}"
      ;;
    "frontend")
      port="${FRONTEND_PORT:-"2001"}"
      ;;
    *)
      echo "Invalid project: ${project}"
      exit 1
      ;;
  esac

  echo "Building: ${project}"

  "$(dirname -- "${BASH_SOURCE[0]}")/dagger" load \
    --workspace="${project}" \
    --docker-socket="${dockerSocket}" \
    "${buildEnvArgs[@]}"

  docker rm -f "${name}" || true

  if [[ -n "${storybookPort}" ]]; then
    docker run --rm -d \
      -p "${port}:${containerPort}" \
      -p "${storybookPort}:${storybookContainerPort}" \
      --name "${name}" "${name}"
  else
    docker run --rm -d \
      -p "${port}:${containerPort}" \
      "${runArgs[@]}" \
      --name "${name}" "${name}"
  fi

  echo "✅ ${name} is running on http://localhost:${port}"

  if [[ -n "${storybookPort}" ]]; then
    echo "✅ storybook is running on http://localhost:${storybookPort}"
  fi
done

echo "✅ All good!"
