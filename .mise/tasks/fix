#!/usr/bin/env bash
#MISE description="Export all top-level declarations, then apply the editor's on-save code actions (fixAll.oxc, organize/sort imports, organize link definitions, sort JSON) to all files; --staged limits it to staged files, --remove-comments also strips comments"

set -o errexit

codeActionArgs=()
staged="false"

while [[ "${#}" -gt 0 ]]; do
  case "${1}" in
    --remove-comments)
      codeActionArgs+=("--remove-comments")
      shift
      ;;
    --staged)
      staged="true"
      codeActionArgs+=("--staged")
      shift
      ;;
    *)
      echo "Usage: mise run fix [--staged] [--remove-comments]"
      exit 1
      ;;
  esac
done

targets=()
if [[ "${staged}" == "true" ]]; then
  while IFS= read -r -d '' file; do
    targets+=("${file}")
  done < <(git diff --cached --name-only -z --diff-filter=ACMR)

  if [[ "${#targets[@]}" -eq 0 ]]; then
    echo "No staged files to fix"
    exit 0
  fi

  targets=(--no-error-on-unmatched-pattern "${targets[@]}")
fi

vpx scripts/code-actions.ts "${codeActionArgs[@]}"

lintSuccess="true"
vp lint --fix "${targets[@]}" || lintSuccess="false"

echo ""
if [[ "${lintSuccess}" == "false" ]]; then
  echo "❌ Code actions applied, but \`vp lint\` reported issues it could not fix"
  exit 1
fi

formatSuccess="true"
vp format --write "${targets[@]}" || formatSuccess="false"

echo ""
if [[ "${formatSuccess}" == "false" ]]; then
  echo "❌ Code actions applied, but \`vp format\` reported issues it could not fix"
  exit 1
fi

if [[ "${staged}" == "true" ]]; then
  echo "✅ Code actions applied to the staged files (re-stage them to commit the fixes)"
else
  echo "✅ Code actions applied to all files"
fi
