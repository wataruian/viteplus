#!/usr/bin/env bash
#MISE description="Export all top-level declarations, then apply the editor's on-save code actions (fixAll.oxc, organize/sort imports, organize link definitions, sort JSON) to all files; --remove-comments also strips comments"

set -o errexit

codeActionArgs=()

while [[ "${#}" -gt 0 ]]; do
  case "${1}" in
    --remove-comments)
      codeActionArgs+=("--remove-comments")
      shift
      ;;
    *)
      echo "Usage: mise run fix [--remove-comments]"
      exit 1
      ;;
  esac
done

node scripts/code-actions.ts "${codeActionArgs[@]}"

lintSuccess="true"
vp lint --fix || lintSuccess="false"

echo ""
if [[ "${lintSuccess}" == "false" ]]; then
  echo "❌ Code actions applied, but \`vp lint\` reported issues it could not fix"
  exit 1
fi

formatSuccess="true"
vp format --write || formatSuccess="false"

echo ""
if [[ "${formatSuccess}" == "false" ]]; then
  echo "❌ Code actions applied, but \`vp format\` reported issues it could not fix"
  exit 1
fi

echo "✅ Code actions applied to all files"
