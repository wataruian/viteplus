{
  "npm.scriptRunner": "vp",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.fmt.configPath": "./vite.config.ts",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "unocss.root": ["./packages/design-system"],
  "unocss.include": ["**/*.{ts,tsx,js,jsx,astro,svelte,vue,html,css,scss,sass}/**"],
  "unocss.exclude": ["**/node_modules/**", "**/dist/**"],
  "unocss.disable": false,
  "unocss.autocomplete.strict": true,
  "unocss.strictAnnotationMatch": true,
  "unocss.colorPreview": true,
  "unocss.colorPreviewRadius": "50%",
  "unocss.remToPxPreview": true,
  "unocss.remToPxRatio": 16,
  "unocss.selectionStyle": true,
  "unocss.underline": true
}
