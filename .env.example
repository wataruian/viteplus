# Copy to .env (mise loads it into the shell; docker compose and Dagger read it too).
# Comments must be on their own line. VITE_X mirrors X for browser code: Vite only exposes
# VITE_* to the bundle, and getEnv('X') falls back to VITE_X. Mirror only keys browser code
# reads, never a secret (it is inlined into the bundle) or a key that can be empty.

# Dagger CI engine
DAGGER_NO_NAG="1"
DAGGER_CLOUD_TOKEN=""
_EXPERIMENTAL_DAGGER_RUNNER_HOST="docker-container://dagger-engine"

# Cloudflare deploys (Dagger wrangler, remote D1)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# HTTP proxy for the compose registry cache (empty: the compose default)
REGISTRY_CACHE_URL=""

# docker compose: host address the published ports bind to, Grafana login
COMPOSE_BIND_ADDRESS="127.0.0.1"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

# Self-hosted GitHub Actions runner and its scaler
GH_REPO_URL="https://github.com/wataruian/viteplus"
GH_RUNNER_TOKEN=""
GH_RUNNER_NAME="gh-runner"
GH_RUNNER_MIN="1"
GH_RUNNER_MAX="5"
GH_RUNNER_SCALE_INTERVAL_SECONDS="60"

# SonarQube
SONAR_TOKEN=""
SONAR_HOST_URL=""

# Logging
DEBUG="false"
LOG_LEVEL="info"

# Backend IP filter (comma-separated lists)
ALLOW_ALL_IPS=""
BLOCK_ALL_IPS=""
ALLOWED_IPS=""

# Backend: proxies trusted for X-Forwarded-For (Node only), 5xx details, sample /api/test routes
TRUSTED_PROXIES=""
ENABLE_ERROR_STACK=""
DISABLE_TEST_ROUTES="false"

# local | test | develop | staging | production
ENV="local"
VITE_ENV="${ENV}"

# Telemetry (collector and Faro receiver from docker compose)
SKIP_OPENTELEMETRY="false"

TELEMETRY_DEBUG="false"
STYLE_COMPILE_DEBUG="false"

OTLP_ENDPOINT="http://localhost:4318"
VITE_OTLP_ENDPOINT="${OTLP_ENDPOINT}"

FARO_ENDPOINT="http://localhost:12347"
VITE_FARO_ENDPOINT="${FARO_ENDPOINT}"

# Backend: extra CORS/CSP origins (comma-separated)
ADDITIONAL_CORS_ORIGINS=""

# Background jobs (templates/tasks): memory | database, lease and retention timings
JOB_STORE="database"
WORKER_LEASE_MS="30000"
WORKER_POLL_INTERVAL_MS="1000"
WORKER_IDLE_POLL_MAX_MS="30000"
WORKER_SHUTDOWN_GRACE_MS="15000"
JOB_RETENTION_SUCCEEDED_MS="604800000"
JOB_RETENTION_DEAD_MS="2592000000"
JOB_PURGE_INTERVAL_MS="3600000"
JOB_PURGE_BATCH_SIZE="500"
JOB_PURGE_MAX_BATCHES="20"

# postgres | d1
DATABASE_DIALECT="postgres"

# Shared compose Postgres server; each database package has its own database below
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="lightproject"
POSTGRES_PASSWORD="lightproject"

# Template apps (ports 2000+, inspectors 8230+). Only ports, URLs, run tokens and
# concurrency get the app prefix; everything else is shared
BACKEND_PORT="2000"
BACKEND_INSPECTOR_PORT="8230"
BACKEND_URL="http://localhost:${BACKEND_PORT}"
VITE_BACKEND_URL="${BACKEND_URL}"

FRONTEND_PORT="2001"
FRONTEND_INSPECTOR_PORT="8231"
FRONTEND_E2E_PORT="2111"
FRONTEND_URL="http://localhost:${FRONTEND_PORT}"
VITE_FRONTEND_URL="${FRONTEND_URL}"

TASKS_PORT="2002"
TASKS_INSPECTOR_PORT="8232"

SCHEDULER_PORT="2003"
SCHEDULER_INSPECTOR_PORT="8233"
SCHEDULER_RUN_TOKEN=""

# Reserved for the real apps created from the templates (ports 3000+, inspectors 9230+):
# api, admin, site, workers, dispatcher. Unused until they exist; do not remove
API_PORT="3000"
API_INSPECTOR_PORT="9230"
API_URL="http://localhost:${API_PORT}"
VITE_API_URL="${API_URL}"

ADMIN_PORT="3001"
ADMIN_INSPECTOR_PORT="9231"
ADMIN_E2E_PORT="3111"
ADMIN_URL="http://localhost:${ADMIN_PORT}"
VITE_ADMIN_URL="${ADMIN_URL}"

SITE_PORT="3002"
SITE_INSPECTOR_PORT="9232"
SITE_E2E_PORT="3112"
SITE_URL="http://localhost:${SITE_PORT}"
VITE_SITE_URL="${SITE_URL}"

WORKERS_PORT="3003"
WORKERS_INSPECTOR_PORT="9233"

DISPATCHER_PORT="3004"
DISPATCHER_INSPECTOR_PORT="9234"
DISPATCHER_RUN_TOKEN=""

# Design System
STORYBOOK_PORT="6006"
STORYBOOK_INSPECTOR_PORT="6232"
STORYBOOK_E2E_PORT="6116"

# Storybook
DESIGN_SYSTEM_PORT="6007"
DESIGN_SYSTEM_INSPECTOR_PORT="6233"
DESIGN_SYSTEM_E2E_PORT="6117"

# One database per database package (created by configs/postgres/create-databases.sh)
DATASTORE_POSTGRES_DB="lightproject_datastore"
DATASTORE_POSTGRES_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${DATASTORE_POSTGRES_DB}"
DATABASE_POSTGRES_DB="lightproject"
DATABASE_POSTGRES_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${DATABASE_POSTGRES_DB}"

# Workers per job function, e.g. ping=2,email=4
TASKS_CONCURRENCY="ping=2"
WORKERS_CONCURRENCY=""
