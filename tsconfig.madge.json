{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lightproject/backend": ["templates/backend/src/client.ts"],
      "@lightproject/backend/*": ["templates/backend/src/*"],
      "@lightproject/common": ["packages/common/src/index.ts"],
      "@lightproject/common/*": ["packages/common/src/*"],
      "@lightproject/datastore": ["templates/datastore/src/index.ts"],
      "@lightproject/datastore/*": ["templates/datastore/src/*"],
      "@lightproject/design-system": ["packages/design-system/src/index.ts"],
      "@lightproject/design-system/*": ["packages/design-system/src/*"],
      "@lightproject/frontend/*": ["templates/frontend/src/*"],
      "@lightproject/library": ["templates/library/src/index.ts"],
      "@lightproject/library/*": ["templates/library/src/*"],
      "@lightproject/tasks": ["templates/tasks/src/client.ts"],
      "@lightproject/tasks/*": ["templates/tasks/src/*"],
      "@storybook/*": ["package.json"],
      "@t3-oss/env-core": ["package.json"],
      "@vitejs/plugin-react": ["package.json"],
      "storybook/*": ["package.json"],
      "virtual:*": ["package.json"],
      "vite-plus/pack": ["package.json"],
      "vite-plus/test": ["package.json"]
    }
