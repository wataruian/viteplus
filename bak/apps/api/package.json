{
  "name": "@lightproject/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "autogen": "tsx --conditions=typescript ./src/utils/autogen.ts",
    "biome:check": "biome check",
    "biome:fix": "biome check --fix",
    "biome:ci": "biome ci",
    "typecheck": "rimraf dist-type && tsc --outDir dist-type --noEmit && rimraf dist-type",
    "build": "rimraf .rolldown && tsdown --config-loader unrun",
    "test": "vitest --run --dir tests",
    "test-trpc": "tsx --conditions=typescript ./test-trpc.ts",
    "test-http": "tsx --conditions=typescript ./test-http.ts",
    "dev": "tsx watch --conditions=typescript ./src/index.ts",
    "start": "node ./dist/index.mjs"
  },
  "dependencies": {
    "@lightproject/common": "workspace:*",
    "@lightproject/database": "workspace:*",
    "@trpc/client": "^11.3.1",
    "@trpc/server": "^11.3.1",
    "axios": "^1.9.0",
    "chalk": "^5.4.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^5.1.0",
    "express-list-endpoints": "^7.1.1",
    "openapi-trpc": "^0.2.1",
    "superjson": "^2.2.2",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "trpc-openapi": "^1.2.0",
    "trpc-playground": "^1.0.4",
    "ts-morph": "^26.0.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@lightproject/typescript": "workspace:*",
    "@lightproject/vitest": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "mock-express": "^2.0.0",
    "supertest": "^7.1.0",
    "vitest": "^3.1.1"
  }
}
