{
  "name": "@lightproject/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "biome:check": "biome check",
    "biome:fix": "biome check --fix",
    "biome:ci": "biome ci",
    "typecheck": "rimraf dist-type && tsc --outDir dist-type --noEmit && rimraf dist-type",
