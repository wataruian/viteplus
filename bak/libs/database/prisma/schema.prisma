datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

generator client_ts {
  provider = "prisma-client"
  output   = "../src/@generated/prisma-client"

  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

