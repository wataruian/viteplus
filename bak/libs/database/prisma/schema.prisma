model Round {
  id                  String  @id @default(uuid())
  bearAmount          Float
  bullAmount          Float
  closeOracleId       Int
  closePrice          Float
  closeTimestamp      Int
  epoch               Int
  lockOracleId        Int
  lockPrice           Float
  lockTimestamp       Int
  oracleCalled        Boolean
  rewardAmount        Float
  rewardBaseCalAmount Float
  startTimestamp      Int
  totalAmount         Float
}
